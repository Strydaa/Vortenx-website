# --- İletişim formu / Contact form (resend.com) ---
# Ücretsiz plan: 3.000 mail/ay. API Keys sayfasından oluştur.
RESEND_API_KEY=
# Formun düşeceği adres
CONTACT_TO_EMAIL=
# Gönderen adresi. Resend'de domain doğrulayana kadar bunu kullanabilirsin:
CONTACT_FROM_EMAIL=NextFlow <onboarding@resend.dev>

# --- Sitedeki AI sohbet botu (console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Site adresi (canonical / sitemap / OG için) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
